{
  "info": {
    "name": "WINUP · Producción",
    "description": "Colección para probar la API de WINUP en https://winup.site. Importable en Postman y Thunder Client. Flujo recomendado: salud, registro o login, listar partidos, crear apuesta, cartera, pagos, notificaciones y administración.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "8f1c2b40-6a4e-4f62-9d3a-1c5b7e9a2d10"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const isPostman = typeof pm !== 'undefined';",
          "const isThunder = typeof tc !== 'undefined';",
          "",
          "let body = null;",
          "try {",
          "  body = isPostman ? pm.response.json() : (isThunder ? tc.response.json : null);",
          "} catch (error) {",
          "  body = null;",
          "}",
          "",
          "const save = (key, value) => {",
          "  if (value === undefined || value === null || value === '') {",
          "    return;",
          "  }",
          "  if (isPostman) {",
          "    if (pm.environment.name) {",
          "      pm.environment.set(key, value);",
          "    }",
          "    pm.collectionVariables.set(key, value);",
          "  } else if (isThunder) {",
          "    tc.setVar(key, value);",
          "  }",
          "};",
          "",
          "if (isPostman) {",
          "  pm.test('Respuesta correcta', () => pm.response.to.be.success);",
          "} else if (isThunder) {",
          "  tc.test('Respuesta correcta', () => tc.response.status >= 200 && tc.response.status < 300);",
          "}",
          "",
          "if (body !== null) {",
          "  if (body.token) {",
          "    save('token', body.token);",
          "    save('userId', body.user && body.user.id);",
          "  }",
          "",
          "  if (Array.isArray(body.items)) {",
          "    const match = body.items.find((item) => item.status === 'OPEN') || body.items[0];",
          "    if (match) {",
          "      save('matchId', match.id);",
          "    }",
          "  }",
          "",
          "  if (isPostman) {",
          "    const name = pm.info.requestName;",
          "    if (name === 'Crear apuesta') {",
          "      save('betId', body.id);",
          "    }",
          "    if (name === 'Crear depósito') {",
          "      save('depositId', body.id);",
          "      save('checkoutUrl', body.checkoutUrl);",
          "    }",
          "    if (name === 'Crear retiro') {",
          "      save('withdrawalId', body.id);",
          "    }",
          "    if (name === 'Listar notificaciones' && Array.isArray(body) && body.length > 0) {",
          "      save('notificationId', body[0].id);",
          "    }",
          "    if (name === 'Crear promoción') {",
          "      save('promoId', body.id);",
          "    }",
          "  }",
          "}"
        ]
      }
    }
  ],
