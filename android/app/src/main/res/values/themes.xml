<resources>
    <style name="Theme.WinUp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/winup_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.WinUp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/winup_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_winup</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.WinUp</item>
    </style>
</resources>
