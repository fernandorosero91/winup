# WINUP — variables de entorno
# Copia este archivo a .env y rellena los valores.
# En Dokploy, pega solo las líneas KEY=VALUE en el editor de variables.

# ---------------------------------------------------------------------------
# Base de datos
# Contraseña del usuario winup en PostgreSQL. Obligatoria.
# ---------------------------------------------------------------------------
WINUP_DB_PASSWORD=""

# ---------------------------------------------------------------------------
# Seguridad
# Secreto HS256 de los JWT. Mínimo 32 bytes. Cualquier cambio cierra sesiones.
# ---------------------------------------------------------------------------
WINUP_JWT_SECRET=""

# ---------------------------------------------------------------------------
# Dominio y URLs públicas
# WINUP_PUBLIC_URL se usa en correos y en la página pública de retorno.
# ---------------------------------------------------------------------------
WINUP_PUBLIC_URL="https://winup.site"
WINUP_ALLOWED_ORIGINS="https://winup.site"
WINUP_ALLOWED_RETURN_ORIGINS="https://winup.site"
WINUP_WEB_RETURN_URL="https://winup.site/cartera"

# ---------------------------------------------------------------------------
# Mercado Pago: depósitos con Checkout Pro
# Con SANDBOX=true se usa sandbox_init_point. El token de prueba puede
# empezar por APP_USR; lo que manda es el entorno del panel.
# La clave del webhook se copia del panel de Mercado Pago.
# ---------------------------------------------------------------------------
WINUP_PAYMENTS_PROVIDER="mercadopago"
WINUP_MERCADOPAGO_SANDBOX="true"
WINUP_MERCADOPAGO_ACCESS_TOKEN=""
WINUP_MERCADOPAGO_PUBLIC_KEY=""
WINUP_MERCADOPAGO_NOTIFICATION_URL="https://winup.site/api/v1/webhooks/mercadopago"
WINUP_MERCADOPAGO_BACK_URL="https://winup.site/cartera"
WINUP_MERCADOPAGO_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Retiros
# El simulador paga al instante. Los retiros por encima del umbral quedan
# pendientes de aprobación. El límite diario en 0 se desactiva.
# ---------------------------------------------------------------------------
WINUP_PAYOUT_PROVIDER="simulator"
WINUP_WITHDRAWALS_APPROVAL_THRESHOLD="200000.00"
WINUP_WITHDRAWALS_DAILY_LIMIT="0"

# ---------------------------------------------------------------------------
# Correo saliente
# Gmail exige contraseña de aplicación y que MAIL_FROM coincida con la cuenta.
# La contraseña de aplicación va sin espacios.
# ---------------------------------------------------------------------------
WINUP_MAIL_ENABLED="true"
WINUP_MAIL_FROM="WINUP <no-reply@winup.site>"
WINUP_SMTP_HOST="smtp.gmail.com"
WINUP_SMTP_PORT="587"
WINUP_SMTP_USERNAME=""
WINUP_SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# Datos deportivos
# random mantiene el generador actual; replay carga una captura local fija.
# ---------------------------------------------------------------------------
WINUP_SPORTS_PROVIDER="random"
WINUP_SPORTS_REPLAY_PATH="classpath:sports/replay-fixtures.json"
WINUP_SPORTS_QUOTA_DAILY_LIMIT="100"

# Footballdata.io: recomendado para temporadas actuales y cuotas.
WINUP_FOOTBALLDATA_BASE_URL="https://footballdata.io/api/v1"
WINUP_FOOTBALLDATA_API_KEY=""
WINUP_FOOTBALLDATA_LEAGUE_ID="10"
WINUP_FOOTBALLDATA_SEASON_ID="0"
WINUP_FOOTBALLDATA_LANGUAGE="es"
WINUP_FOOTBALLDATA_TIMEOUT_MS="8000"

# API-Football: alternativa historica; requiere plan de pago para la temporada actual.
WINUP_API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
WINUP_API_FOOTBALL_KEY=""
WINUP_API_FOOTBALL_LEAGUE_ID="140"
WINUP_API_FOOTBALL_SEASON="2026"
WINUP_API_FOOTBALL_TIMEOUT_MS="8000"

# Almacen de cuota del proveedor: jdbc (distribuido) o memory (solo pruebas).
WINUP_SPORTS_QUOTA_STORE="jdbc"

# Ingesta automatica: desactivada por defecto. Requiere un proveedor activo.
WINUP_SPORTS_INGESTION_ENABLED="false"
WINUP_SPORTS_INGESTION_LIVE_ENABLED="false"
WINUP_SPORTS_INGESTION_LIVE_INTERVAL_MS="600000"
WINUP_SPORTS_INGESTION_SPORT="Fútbol"
WINUP_SPORTS_INGESTION_INTERVAL_MS="600000"
WINUP_SPORTS_INGESTION_LOOKBACK_HOURS="24"
WINUP_SPORTS_INGESTION_LOOKAHEAD_HOURS="48"

# ---------------------------------------------------------------------------
# Notificaciones push
# realtime usa el WebSocket; fcm requiere las claves de Firebase.
# ---------------------------------------------------------------------------
WINUP_PUSH_PROVIDER="realtime"

# ---------------------------------------------------------------------------
# Solo para el compose local con Caddy
# En Dokploy no se usan: Traefik publica 80 y 443.
# ---------------------------------------------------------------------------
WINUP_FRONTEND_BIND="127.0.0.1:4200"
WINUP_API_BIND="127.0.0.1:8080"
